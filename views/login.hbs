
<div class="container">
    <h5 class="text-center"><b>hello !</b></h5>
    <h2 class="text-center mb-5"><b>welcome back</b></h2>

    <span class="danger">{{message}}</span>
    <form class="row g-3" method="post" action="/submit">
    <div class="form-floating mb-3">
      <input type="email" class="form-control bg-transparent focus-ring focus-ring-light" name="email" id="floatingInput" placeholder="name@example.com">
      <label for="floatingInput">Email address</label>
    </div>
    <div class="form-floating">
      <input type="password" class="form-control bg-transparent focus-ring focus-ring-light" name="password" id="floatingPassword" placeholder="Password">
      <label for="floatingPassword">Password</label>
    </div>
    <div class="col-12 mt-2">
      <button type="submit" class="btn btn-color mt-4 mb-4">LOG IN</button>
    </div>
    <span class="rule mt-4"></span>
    <a href="/index" class="link">Register Now</a>
    </form>
    
  </div>